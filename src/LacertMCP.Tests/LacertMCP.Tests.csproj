<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- P14-038: shared TFM/platform/lang/nullable props live in Directory.Build.props. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>LacertMCP.Tests</RootNamespace>
    <AssemblyName>LacertMCP.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- P14-041: on-demand coverage so the operator can spot-check that all 13
         tools and every access-map branch are exercised. No CI threshold yet -
         a solo-operator tool with no pipeline shouldn't bikeshed gates.
         Invoke with:
           dotnet test '-'-collect:"XPlat Code Coverage" '-'-settings coverlet.runsettings
         or via msbuild integration:
           dotnet test /p:CollectCoverage=true /p:CoverletOutputFormat=cobertura -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LacertMCP.Server\LacertMCP.Server.csproj" />
    <ProjectReference Include="..\LacertMCP.Cli\LacertMCP.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- F10 parity recording fixtures — copy to the test bin so the
         RecordingBridge can load them at runtime by resolving paths
         relative to the running assembly. -->
    <Content Include="Parity\fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- P14-041: keep the coverlet runsettings visible in the project tree. -->
    <None Include="coverlet.runsettings" />
  </ItemGroup>

</Project>

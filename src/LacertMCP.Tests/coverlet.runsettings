<?xml version="1.0" encoding="utf-8"?>
<!--
  P14-041: On-demand coverage settings for the LacertMCP test suite.

  Invoke with:
    dotnet test src/LacertMCP.Tests/LacertMCP.Tests.csproj \
      --collect:"XPlat Code Coverage" \
      --settings src/LacertMCP.Tests/coverlet.runsettings

  Excludes:
    - LacertMCP.FieldAccessDumper — one-shot dev tool that scrapes the live SDK;
      not part of runtime coverage.
    - Test assembly itself (xunit auto-exclusion).
    - Generated bridge / interop type-library code (auto-generated by tlbimp /
      System.CommandLine bindings).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[LacertMCP.FieldAccessDumper]*,[LacertMCP.Tests]*,[xunit.*]*</Exclude>
          <ExcludeByFile>**/obj/**/*.cs,**/*.Designer.cs,**/*.g.cs,**/AssemblyInfo.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

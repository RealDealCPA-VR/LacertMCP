<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Load-bearing runtime shim for the Lacerte SDK.
    Lacerte's mixed-mode CLR (LacerteSDK_Access) requires the legacy v2 runtime
    activation policy AND a supportedRuntime declaration. Without this block,
    `new LacerteSDK_Access.LacerteAccess()` throws on construction.
    Do not remove. See ARCHITECTURE.md "Build & Runtime" + DECISIONS.md
    2026-05-30 "Language/runtime stack".
  -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      P14-038: TargetFramework / PlatformTarget / Platforms / LangVersion / Nullable
      live in Directory.Build.props at the repo root.
      P14-040: Version / AssemblyVersion / FileVersion / InformationalVersion ditto.
    -->
    <OutputType>Exe</OutputType>
    <RootNamespace>LacertMCP.Server</RootNamespace>
    <AssemblyName>LacertMCP.Server</AssemblyName>
    <!-- Required for COM/.NET mixed-mode load of LacerteSDK_Access -->
    <UseAppConfig>true</UseAppConfig>
    <AppConfig>App.config</AppConfig>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP server SDK (Microsoft + Anthropic official). Use the latest stable 1.x. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <!-- Hosting + DI + logging. 8.0.x is the last line that supports net48 cleanly. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- System.Text.Json on net48 ships via NuGet; 10.0.7 matches the floor
         ModelContextProtocol.Core 1.4.0 requires (still targets net462+). -->
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Data.Odbc ships in the net48 BCL — no PackageReference needed. -->
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
    <!-- Microsoft.CSharp is required for `dynamic` keyword usage in Bridge/* (late-bound COM calls). -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sharded JSON field-access map — loaded at runtime by FieldAccessMapLoader.
         Copy the entire tree (base/*.json + overlays/*.json + manifest.json) to
         the build output so the loader can read them next to the assembly. -->
    <Content Include="Schema\FieldAccessMap\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal members (e.g. FieldAccessMapLoader.ResetCacheForTests)
         to the test assembly. Required by FieldAccessMapCoverageTests and the
         AccessMapTestFixture used by Tools tests. -->
    <InternalsVisibleTo Include="LacertMCP.Tests" />
  </ItemGroup>

</Project>

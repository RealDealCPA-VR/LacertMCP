<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Load-bearing runtime shim for the Lacerte SDK — mirrors
    src/LacertMCP.Server/App.config. This executable references
    LacertMCP.Server and can activate LacerteSDK_Access COM in-process
    (lacerte-mcp register / login run Bridge.Registration.Register, which
    constructs TPRegistration; the FieldAccessDumper's live probe goes through
    the same Bridge). Lacerte's mixed-mode CLR requires the legacy v2 runtime
    activation policy AND a supportedRuntime declaration in the HOST exe's
    config — the server's config does not apply to this process.
    Do not remove. `lacerte-mcp doctor` checks for it (App.config shim probe).
    See ARCHITECTURE.md "Build & Runtime" + DECISIONS.md 2026-05-30
    "Language/runtime stack".
  -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
</configuration>

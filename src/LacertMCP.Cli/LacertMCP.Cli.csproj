<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- P14-038: shared TFM/platform/lang/nullable props live in Directory.Build.props. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>LacertMCP.Cli</RootNamespace>
    <AssemblyName>lacerte-mcp</AssemblyName>
    <!-- Load-bearing legacy-runtime shim (useLegacyV2RuntimeActivationPolicy):
         register/login activate LacerteSDK_Access COM in-process via
         Bridge.Registration. Mirrors the Server; doctor probes the emitted
         lacerte-mcp.exe.config. -->
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.CommandLine is still officially preview at the time of writing
         (the team has signaled GA but it's not stamped stable yet). Preview is
         fine for an operator CLI; pin to a known-good build. -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- `update` command: GitHub Releases download, zip extraction, launcher (WMI) control. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse Credential Manager / registration helpers from the server assembly. -->
    <ProjectReference Include="..\LacertMCP.Server\LacertMCP.Server.csproj" />
  </ItemGroup>

</Project>

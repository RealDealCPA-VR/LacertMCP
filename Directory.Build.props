<Project>

  <!--
    P14-038 + P14-040 — Shared MSBuild properties for every project in this repo.

    Consolidates the TargetFramework / PlatformTarget / Platforms / LangVersion / Nullable
    properties that all four csprojs were duplicating (Server, Cli, Tests, FieldAccessDumper).
    Per-project overrides (OutputType, RootNamespace, AssemblyName, IsPackable) stay
    in each csproj.

    Version stamping (P14-040): every assembly gets the same Version/AssemblyVersion/
    FileVersion/InformationalVersion so `lacerte-mcp status`, `lacerte_session_status`,
    and the Doctor probe can emit a copy-pasteable build stamp for bug reports.
    Bump these by hand on every release tag (no MinVer / Nerdbank — overkill for a
    single-operator personal tool per CLAUDE.md).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!--
      Include the short git SHA when MSBuild has it (CI fills SourceRevisionId);
      fall back to the bare version in non-git / sim builds so this never trips
      a "Substring out of range" exception.
    -->
    <InformationalVersion Condition="'$(SourceRevisionId)' != '' AND $(SourceRevisionId.Length) &gt;= 7">$(Version)+$(SourceRevisionId.Substring(0,7))</InformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      P14-009 — net48 reference assemblies so `dotnet build` can resolve mscorlib
      / System.* on non-Windows hosts (e.g. ubuntu-latest CI runners). On Windows
      MSBuild finds these from the SDK; on Linux it cannot without this package.
      `PrivateAssets=all` keeps it from flowing as a transitive dependency to
      anything that ProjectReferences us.

      Note: this enables a Linux build-only smoke. `dotnet test` against net48
      assemblies on Linux still requires Mono and is not attempted in CI.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>

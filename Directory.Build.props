<Project>

  <!--
    P14-038 + P14-040 — Shared MSBuild properties for every project in this repo.

    Consolidates the TargetFramework / PlatformTarget / Platforms / LangVersion / Nullable
    properties that all four csprojs were duplicating (Server, Cli, Tests, FieldAccessDumper).
    Per-project overrides (OutputType, RootNamespace, AssemblyName, IsPackable) stay
    in each csproj.

    Version stamping (P14-040): every assembly gets the same Version/AssemblyVersion/
    FileVersion/InformationalVersion so `lacerte-mcp status`, `lacerte_session_status`,
    and the Doctor probe can emit a copy-pasteable build stamp for bug reports.
    Bump these by hand on every release tag (no MinVer / Nerdbank — overkill for a
    single-operator personal tool per CLAUDE.md).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Flatten output so scripts/release.ps1 finds bin/x64/Release (no net48 subfolder) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!--
      P17-009 — Include the short git SHA in InformationalVersion when
      $(SourceRevisionId) is populated AT EVALUATION TIME, i.e. only when it
      is passed on the command line:
        - .github/workflows/ci.yml: `-p:SourceRevisionId=${{ github.sha }}`
        - scripts/release.ps1: `-p:SourceRevisionId=$(git rev-parse HEAD)`
      Local `dotnet build` without that arg produces the bare $(Version) —
      intentional: SourceLink does set SourceRevisionId mid-build in a git
      checkout, but that happens after property evaluation, so the +sha7
      suffix below never applies locally. Only CI/release builds get
      `0.1.0+<sha7>`.
      The Substring(0,7) guard never trips because the outer Length >= 7
      condition gates entry to the .Substring expression.

      R6-16 — IncludeSourceRevisionInInformationalVersion=false stops the
      SDK's GenerateAssemblyInfo target from appending the FULL 40-char SHA
      on top of this props-level value (which produced
      `0.1.0+abc1234.<full-40-char-sha>` in CI and `0.1.0+<full-40-char-sha>`
      locally). With it false, the stamp is exactly `0.1.0+<sha7>` when
      SourceRevisionId is passed, and bare `0.1.0` otherwise.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != '' AND $(SourceRevisionId.Length) &gt;= 7">$(Version)+$(SourceRevisionId.Substring(0,7))</InformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      P14-009 — net48 reference assemblies so `dotnet build` can resolve mscorlib
      / System.* on non-Windows hosts (e.g. ubuntu-latest CI runners). On Windows
      MSBuild finds these from the SDK; on Linux it cannot without this package.
      `PrivateAssets=all` keeps it from flowing as a transitive dependency to
      anything that ProjectReferences us.

      Note: this enables a Linux build-only smoke. `dotnet test` against net48
      assemblies on Linux still requires Mono and is not attempted in CI.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>

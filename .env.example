# Lacerte MCP — environment variables
# Copy to .env and fill in. Never commit .env.

# Identity registered with Lacerte. AppName is read at runtime (default: LacerteMCP).
LACERTE_APP_NAME=LacerteMCP

# AppID is NOT set here. The GUID is minted by `lacerte-mcp register` into Windows
# Credential Manager (target=lacerte-mcp, account=app-id). Off-Windows or with
# LACERTE_MCP_FORCE_FILE_STORE=1 it falls back to %APPDATA%/lacerte-mcp/config.json.
# See DECISIONS.md 2026-05-30 "AppID GUID in Windows Credential Manager" for rationale.

# Default tax year used when a tool call omits one (TY18+)
LACERTE_DEFAULT_TAX_YEAR=2024

# Advisory only — referenced in doctor diagnostics and ODBC error remediations.
# Does NOT auto-populate session context; every session still calls
# lacerte_set_context. Example: C:\Lacerte\24Data
LACERTE_DATA_PATH=

# Mode: live = real SDK calls; simulation = in-memory fixtures (default off Windows)
LACERTE_LIVE=0
LACERTE_SIMULATION=1

# ODBC: connections are DSN-less - composed from driver + datapath + module + year.
# The `LacerteDSII` DSN name is only probed by `lacerte-mcp doctor` as a sanity
# check; no env var is honored at runtime. (See ARCHITECTURE.md "Configuration".)

# Debug / wire logging
LACERTE_DEBUG_WIRE=0
LACERTE_DEBUG_LOG_PATH=./logs

# Minimum host log level: Trace | Debug | Information | Warning | Error | Critical | None (default: Information).
LACERTE_LOG_LEVEL=

# 1 allows UNC paths (\\server\share) for LACERTE_DEBUG_LOG_PATH / data paths (default: rejected).
LACERTE_ALLOW_UNC=

# Per-debug-log-file size cap in bytes before rotation (non-negative integer; default built-in).
LACERTE_DEBUG_LOG_MAX_BYTES=

# Total debug-log directory size cap in bytes (non-negative integer; default built-in).
LACERTE_DEBUG_LOG_MAX_DIR_BYTES=

# Days to keep rotated debug-log files before cleanup (non-negative integer; default built-in).
LACERTE_DEBUG_LOG_RETENTION_DAYS=

# Max characters of each tool result sampled into the debug log (non-negative integer; default built-in).
LACERTE_DEBUG_LOG_RESULT_SAMPLE=

# 1 logs FULL tool results to the debug log instead of the truncated sample (PII risk — dev only).
LACERTE_DEBUG_LOG_FULL_RESULTS=

# Heartbeat file cadence (seconds). Writes pid/mode/auth-state JSON to
# %TEMP%/lacerte-mcp-heartbeat-{pid}.json (one file per server process, so
# multiple MCP hosts — Claude Desktop + Cursor — don't clobber each other) for
# external supervisors (Task Scheduler / NSSM / PowerShell watchers) to detect
# a hung server. Set 0 to disable.
LACERTE_HEARTBEAT_SECONDS=30

# Idempotency-cache disk persistence (replay protection across restarts).
# Default ON — set 0 to disable (e.g. for test isolation). Only the exact
# string 0 disables it.
LACERTE_IDEMPOTENCY_PERSIST=

# Override path for the persisted idempotency cache file
# (default: %APPDATA%/lacerte-mcp/idempotency-cache.json).
LACERTE_IDEMPOTENCY_PERSIST_PATH=

# Max entries per lacerte_field_write_bulk / lacerte_detail_write_bulk batch (non-negative integer; default 500; larger batches throw 9020).
LACERTE_BULK_WRITE_MAX=

# Max entries per lacerte_client_create_bulk batch (non-negative integer; default 100; larger batches throw 9020).
LACERTE_BULK_CREATE_MAX=

# In-memory recent-log ring capacity for lacerte_recent_log (non-negative integer; default 256, clamped 16..4096).
LACERTE_RECENT_LOG_CAPACITY=

# Datapath discovery root for `lacerte_list_datapaths` (default: C:\Lacerte)
LACERTE_DATA_ROOT=

# Testing / dev only: 1 forces the file-based AppID store instead of Windows Credential Manager
# (auto-on off-Windows; useful for headless or non-interactive Windows hosts).
LACERTE_MCP_FORCE_FILE_STORE=

# Testing / dev only: 1 makes the simulator report an expired registration (exercises 9007 LoginExpired paths).
LACERTE_SIM_EXPIRED=

# Testing / dev only: PATH to a parity recording file consumed by the parity replay tests
# (Tests/Parity/BothModes.cs). This is a file path, NOT a 0/1 flag.
LACERTE_PARITY_RECORDING=
